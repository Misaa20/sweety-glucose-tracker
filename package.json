{
  "name": "sweety",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["server", "client", "shared"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:test:setup": "npm run db:test:setup -w server",
    "test": "npm run test -w server && npm run test -w client",
    "test:api": "npm run test -w server",
    "test:client": "npm run test -w client",
    "test:e2e": "playwright test",
    "build": "npm run build -w client",
    "start": "npm run start -w server"
  },
  "devDependencies": { "@playwright/test": "^1.56.0", "concurrently": "^9.2.0" }
}

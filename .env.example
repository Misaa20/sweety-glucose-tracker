# Development credentials only. Use your own credentials outside local development.
DATABASE_URL=postgresql://sweety:local_dev_password@localhost:5434/sweety
TEST_DATABASE_URL=postgresql://sweety:local_dev_password@localhost:5434/sweety_test
POSTGRES_USER=sweety
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=sweety
POSTGRES_PORT=5434
REDIS_URL=redis://localhost:6381/0
TEST_REDIS_URL=redis://localhost:6381/15
REDIS_PORT=6381
REPORT_CACHE_TTL=300
# Every day at 21:00 in APP_TIMEZONE. The worker must be running.
REMINDER_CRON=0 21 * * *
# Only used when running the app service through Docker Compose.
DOCKER_APP_PORT=3001
DOCKER_CLIENT_ORIGIN=http://localhost:3001
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
NODE_ENV=development
# Used by the seed script only; these are intentionally public demo credentials.
DEMO_EMAIL=demo@sweety.local
DEMO_PASSWORD=SweetyDemo123!
DEMO_DOCTOR_EMAIL=doctor@sweety.local
DEMO_DOCTOR_PASSWORD=SweetyDoctor123!
